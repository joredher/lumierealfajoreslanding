# Copy to .env.local (never commit .env.local) and fill in.
# Public site URL, no trailing slash. Used for canonical, Open Graph, sitemap, robots and JSON-LD.
VITE_SITE_URL=https://www.your-domain.com
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GA_ID=
